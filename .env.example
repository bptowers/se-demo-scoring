# LLM Provider API Keys
# At least one is required for AI analysis
# Get Gemini key from: https://aistudio.google.com/app/apikey
# Get OpenAI key from: https://platform.openai.com/api-keys
# Get Anthropic key from: https://console.anthropic.com/settings/keys

GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Firebase Authentication (Optional - falls back to demo mode if not configured)
# Get these from: https://console.firebase.google.com/ → Project Settings → General
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ElevenLabs AI Demo Coach (voice agent widget)
# PUBLIC, non-secret identifier — ships in the client bundle by design, like VITE_FIREBASE_* above.
# Access is restricted by the domain Allowlist in the agent's Security tab, not by secrecy.
# Get it from: https://elevenlabs.io/app/agents → your agent → Agent ID
VITE_ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here

# Optional override for the AI Objection Coach (Jordan) agent.
# Also public and non-secret. A working default ships in config/objectionCoachAgent.ts,
# so this only needs setting to point the objection coach at a different agent.
# VITE_ELEVENLABS_JORDAN_AGENT_ID=
