rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user's own evaluations
    match /users/{userId}/evaluations/{evaluationId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Each user's own improvement goals
    match /users/{userId}/goals/{goalId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Morgan live-practice coaching reports (ElevenLabs post-call analysis).
    // Read-only for the owner; writes are server-side only. The elevenLabsPostCallWebhook
    // Cloud Function uses the Admin SDK, which bypasses these rules, so denying all client
    // writes here cannot break report creation — it only stops a browser forging or editing
    // its own coaching evidence.
    match /users/{userId}/practiceReports/{reportId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    // Top-level AE sessions (dual-written on completion for manager queries)
    match /aeSessions/{sessionId} {
      // Any authenticated company user can read — SEs need to query by callDeliveredBy
      // to see their own sessions scored by managers. Access is restricted at the app
      // layer (only sessions matching the user's display name are shown).
      allow read: if request.auth != null;
      // Any authenticated user can write (dual-write on session completion)
      allow write: if request.auth != null;
    }

    // Top-level BDR sessions (dual-written for manager queries)
    match /bdrSessions/{sessionId} {
      // BDR Dashboard managers can read all sessions
      allow read: if request.auth != null && request.auth.token.email in [
        'dave.murphy@bigchange.com',
        'brad.towers@simprogroup.com',
        'pete.mansel@simprogroup.com',
        'david.doloboff@simpro.us'
      ];
      // BDR reps can read their own sessions
      allow read: if request.auth != null &&
        resource.data.bdrRepEmail == request.auth.token.email;
      // Any authenticated user can write (BDR reps saving their own sessions)
      allow write: if request.auth != null;
    }
  }
}
